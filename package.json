{
  "name": "vue-cron-selector",
  "version": "0.1.0",
  "description": "Vue3 Cron 表达式可视化选择组件（Quartz 格式，参考 xxl-job 交互），零第三方依赖",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-cron-selector.umd.cjs",
  "module": "./dist/vue-cron-selector.js",
  "exports": {
    ".": {
      "import": "./dist/vue-cron-selector.js",
      "require": "./dist/vue-cron-selector.umd.cjs"
    },
    "./style.css": "./dist/vue-cron-selector.css"
  },
  "keywords": [
    "vue3",
    "cron",
    "cron-picker",
    "cron-editor",
    "quartz",
    "xxl-job"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:demo": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5",
    "vue": "^3.5.13"
  }
}
